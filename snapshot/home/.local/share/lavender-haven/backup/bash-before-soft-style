# Lavender Haven — current user's interactive Bash theme.
[[ $- == *i* && ${TERM:-dumb} != dumb ]] || return

__lavender_haven_prompt() {
    local last_status=$?
    local branch='' changes=''
    __lh_git=''
    __lh_status=''
    if (( last_status != 0 )); then
        printf -v __lh_status ' %s' "$last_status"
    fi
    if command -v git >/dev/null 2>&1; then
        branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) ||
            branch=$(git rev-parse --short HEAD 2>/dev/null) || branch=''
        if [[ -n $branch ]]; then
            changes=$(GIT_OPTIONAL_LOCKS=0 git status --porcelain --untracked-files=no 2>/dev/null)
            __lh_git=" · ${branch}"
            [[ -z $changes ]] || __lh_git+=' *'
        fi
    fi
    # \[ and \] keep Readline's cursor accounting correct on wrapped lines.
    # Git text is expanded as data, never evaluated as prompt code.
    PS1='\n\[\e[38;2;185;160;221m\]╭─ \u\[\e[38;2;113;101;127m\] · \[\e[38;2;230;223;238m\]\w\[\e[38;2;169;189;160m\]${__lh_git}\[\e[38;2;217;147;156m\]${__lh_status}\n\[\e[38;2;185;160;221m\]╰─\$\[\e[0m\] '
    return "$last_status"
}

# Preserve existing prompt hooks, including terminal integration hooks.
if [[ $(declare -p PROMPT_COMMAND 2>/dev/null) == 'declare -a '* ]]; then
    if [[ " ${PROMPT_COMMAND[*]} " != *'__lavender_haven_prompt'* ]]; then
        PROMPT_COMMAND=(__lavender_haven_prompt "${PROMPT_COMMAND[@]}")
    fi
elif [[ ${PROMPT_COMMAND:-} != *'__lavender_haven_prompt'* ]]; then
    if [[ -n ${PROMPT_COMMAND:-} ]]; then
        PROMPT_COMMAND=(__lavender_haven_prompt "$PROMPT_COMMAND")
    else
        PROMPT_COMMAND=(__lavender_haven_prompt)
    fi
fi

