<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.lavender-player" path="/org/gnome/shell/extensions/lavender-player/">
    <key name="advanced-visualization" type="b">
      <default>false</default>
      <summary>Advanced visualization</summary>
      <description>Show available artwork, lyrics, and track list.</description>
    </key>
    <key name="audio-wave" type="b">
      <default>false</default>
      <summary>Audio-reactive lavender wave</summary>
      <description>Monitor system output audio and draw a waveform around the player.</description>
    </key>
    <key name="corner" type="s">
      <choices><choice value="bottom-left"/><choice value="bottom-right"/><choice value="top-left"/><choice value="top-right"/></choices>
      <default>'bottom-left'</default>
      <summary>Desktop corner</summary>
      <description>Corner of the primary monitor where the player appears.</description>
    </key>
  </schema>
</schemalist>
